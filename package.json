{
  "name": "yuets",
  "private": "true",
  "description": "A TypeScript rewrite version of Discord bot Yue.",
  "type": "module",
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d",
  "scripts": {
    "build": "npm run clean && tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "deploy-cmd": "node ./dist/deploy-commands.js",
    "start": "node --no-deprecation --no-warnings ./dist/index.js",
    "dev": "concurrently 'npm:watch' 'sleep 5;nodemon ./dist/bot.js'",
    "test": "vitest run",
    "clean": "rimraf dist",
    "format": "prettier --write src/**/*.{ts,js,json}",
    "lint": "eslint src/**/*.ts",
    "lint-fix": "eslint src/**/*.ts --fix",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ppodds/YueTS.git"
  },
  "author": "ppodds",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ppodds/YueTS/issues"
  },
  "lint-staged": {
    "src/**/*.{ts,js,cjs,mjs}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "homepage": "https://github.com/ppodds/YueTS#readme",
  "dependencies": {
    "@discordjs/builders": "~1.10.1",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/rest": "^2.6.1",
    "@discordjs/voice": "^0.18.0",
    "@discordx/importer": "^1.3.3",
    "@ppodds/nhentai-api": "^0.0.1",
    "async-lock": "^1.4.1",
    "axios": "^1.16.1",
    "bufferutil": "^4.1.0",
    "canvas": "^3.2.3",
    "discord-api-types": "^0.37.120",
    "discord.js": "^14.26.4",
    "discord.js-message-listener": "^3.0.3",
    "discordx": "^11.13.3",
    "dotenv": "^16.6.1",
    "ehentai-api": "^0.0.4",
    "file-type": "^16.5.4",
    "log4js": "^6.9.1",
    "mariadb": "^3.5.2",
    "node-worker-threads-pool": "^1.5.1",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.8",
    "sharp": "~0.33.5",
    "sodium-native": "^4.3.3",
    "stream-buffers": "^3.0.3",
    "tslib": "^2.8.1",
    "tsyringe": "^4.10.0",
    "utf-8-validate": "^6.0.6",
    "zlib-sync": "^0.1.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.4",
    "@types/async-lock": "^1.4.2",
    "@types/sequelize": "^4.28.20",
    "@types/stream-buffers": "^3.0.8",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "rimraf": "^5.0.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "version": "1.2.0"
}
