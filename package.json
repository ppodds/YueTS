{
  "name": "yuets",
  "private": "true",
  "description": "A TypeScript rewrite version of Discord bot Yue.",
  "type": "module",
  "packageManager": "pnpm@12.0.0",
  "scripts": {
    "build": "npm run clean && tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "deploy-cmd": "node ./dist/deploy-commands.js",
    "start": "node --no-deprecation --no-warnings ./dist/index.js",
    "dev": "concurrently 'npm:watch' 'sleep 5;nodemon ./dist/bot.js'",
    "test": "vitest run",
    "clean": "rimraf dist",
    "format": "prettier --write src/**/*.{ts,js,json}",
    "lint": "eslint src/**/*.ts",
    "lint-fix": "eslint src/**/*.ts --fix",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ppodds/YueTS.git"
  },
  "author": "ppodds",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ppodds/YueTS/issues"
  },
  "lint-staged": {
    "src/**/*.{ts,js,cjs,mjs}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "homepage": "https://github.com/ppodds/YueTS#readme",
  "dependencies": {
    "@discordjs/builders": "~1.14.1",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/rest": "^2.6.3",
    "@discordjs/voice": "^0.19.2",
    "@discordx/importer": "^1.3.3",
    "@ppodds/nhentai-api": "^0.0.1",
    "async-lock": "^1.4.1",
    "axios": "^1.20.0",
    "bufferutil": "^4.1.0",
    "canvas": "^3.2.3",
    "discord-api-types": "^0.38.53",
    "discord.js": "^14.27.0",
    "discord.js-message-listener": "^3.0.3",
    "discordx": "^11.13.3",
    "dotenv": "^17.4.2",
    "ehentai-api": "^0.0.4",
    "file-type": "^22.0.2",
    "log4js": "^6.9.1",
    "mariadb": "^3.5.3",
    "node-worker-threads-pool": "^1.5.1",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.8",
    "sharp": "~0.35.4",
    "sodium-native": "^5.1.0",
    "stream-buffers": "^3.0.3",
    "tslib": "^2.8.1",
    "tsyringe": "^4.10.0",
    "utf-8-validate": "^6.0.6",
    "zlib-sync": "^0.1.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/async-lock": "^1.4.2",
    "@types/node": "^26.4.0",
    "@types/stream-buffers": "^3.0.8",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "version": "1.3.2"
}
